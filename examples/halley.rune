# Halley compositor configuration.
#
# The default location is:
#   $XDG_CONFIG_HOME/halley/halley.rune
# or, when XDG_CONFIG_HOME is unset:
#   $HOME/.config/halley/halley.rune
#
# Halley creates this file only when it does not already exist. While Halley
# is running, valid saves are applied automatically. A syntactically invalid
# or incomplete save is rejected as one unit and the last valid configuration
# remains active.
#
# Sections and fields may be omitted unless noted otherwise; omitted values
# use their built-in defaults. `keybinds:` is required because it defines the
# compositor's input map. Strings are quoted, booleans are `true` or `false`,
# and each nested block ends with `end`.

# Optional environment variables for applications launched by Halley.
# Additions and changes apply to future launches after a valid live reload;
# already-running applications keep the environment they started with.
# Removing a variable takes effect after restarting Halley.
#
# env:
#   QT_QPA_PLATFORM "wayland"
#   QT_QPA_PLATFORMTHEME "qt6ct"
# end

# Autostart launches session services through the same shell and environment
# as configured keybind commands. `once` runs only when a real TTY compositor
# session starts. `on-reload` runs after every valid config reload. Nested
# Winit development sessions run neither category.
autostart:
  # once "waybar"
  # once "mako"
  # once "dms run"

  # on-reload "notify-send 'Halley configuration reloaded'"
end

# One `output:` block per physical monitor - not a wrapper section, just
# repeat the block for each one. Commented out by default: an active block
# whose `name` happens to match a real connector on your machine would force
# that exact mode, which is very likely wrong for hardware this file wasn't
# written for. Uncomment and edit to match your actual monitor(s) (find real
# connector names/modes with `halleyctl outputs`).
#
# output:
#   # DRM connector name exactly as printed by `halleyctl outputs`.
#   name "DP-1"
#
#   # Pixel dimensions of an advertised mode. Width and height are required
#   # whenever an output block is present.
#   width 2560
#   height 1440
#
#   # Position in the shared desktop coordinate space. (0, 0) is the desktop
#   # origin; place another output to the right by setting its offset-x to the
#   # first output's width. Negative positions are allowed.
#   offset-x 0
#   offset-y 0
#
#   # Must match one of the connector's real modes exactly - no closest-rate
#   # guessing. Omit this line to use the highest refresh available at this
#   # resolution. If the entire output block is omitted, the connector uses
#   # its hardware-preferred mode instead.
#   rate 179.998
#
#   # Clockwise output rotation in degrees: 0, 90, 180, or 270.
#   transform 0
#
#   # Variable refresh rate: "off", "on", or "auto". "on" enables VRR
#   # whenever the connector supports it. "auto" is reserved for automatic
#   # content-aware switching and currently behaves like "off".
#   vrr "auto"
# end
#
# Output reloads are diffed per connector. Changing one output does not force
# an unchanged output through a redundant mode set.

# Keyboard, pointer-focus, physical-device, touch, and gesture settings.
# Keyboard/focus policy and client gesture protocols are backend-independent.
# Physical device settings apply when Halley owns libinput devices on a tty.
input:
  # Key-repeat frequency in presses per second and the delay before repeating.
  # A rate of 0 disables repeat. Both values update without restarting.
  repeat-rate 30
  repeat-delay 500

  # "click" keeps keyboard focus where you click. "hover" follows the pointer
  # across windows and outputs, but never raises windows merely by hovering.
  focus-mode "click"

  # Whether clicking a window also brings it to the top. When false, the click
  # still focuses and activates the window without changing stacking order.
  raise-on-click true

  keyboard:
    # Standard XKB names. Empty variant/options/model use XKB defaults.
    layout "us"
    variant ""
    options ""
    model ""
  end

  gestures:
    # Master switch for Halley's camera gestures. Native client gestures are
    # still passed through when this is false if client-passthrough is true.
    enabled true

    # Send swipe, pinch, and hold sequences to the client under the pointer.
    # Raw touchscreen contacts are controlled separately by touch-passthrough.
    client-passthrough true
    touch-passthrough true

    # The default hybrid routing lets applications own gestures over their
    # windows and lets Halley own gestures on empty field. Holding `modifier`
    # forces eligible gestures to Halley. An active pointer constraint or
    # client grab always remains client-owned.
    pinch-to-zoom true
    pinch-scope "empty-field"      # "empty-field" or "global"
    compositor-scope "empty-field" # three-finger pan scope
    modifier "mod"                 # keybind Mod; also "off" or an exact modifier

    # Two-finger touchpad scrolling pans only when it begins on empty field.
    # Use "off" to always pass finger scrolling through to clients.
    scroll-pan "empty-field"

    # Swipe finger count and optional momentum after a swipe/pinch pan.
    # Set pan-fingers to 0 to disable compositor swipe-panning.
    pan-fingers 3
    pan-momentum true
    pan-decay-rate 6.0
    flick-min-px-per-s 200.0
  end

  touchpad:
    # All fields are optional. Omission restores the device's own libinput
    # default. Unsupported capabilities are ignored by libinput.
    #
    # enabled true
    # natural-scroll false
    # accel-speed 0.0             # -1.0 through 1.0
    # accel-profile "adaptive"    # "adaptive" or "flat"
    # scroll-method "two-finger"  # "none", "two-finger", "edge", or
    #                             # "on-button-down"
    # scroll-button 274
    # scroll-button-lock false
    # left-handed false
    # middle-emulation false
    # tap true
    # tap-button-map "left-right-middle" # or "left-middle-right"
    # dwt true                    # disable while typing
    # click-method "clickfinger"  # or "button-areas"
    # drag true
    # drag-lock false
    # disabled-on-external-mouse false
  end

  mouse:
    # Every setting is optional. Omitted values preserve each device's own
    # libinput default, including after a live reload removes an old setting.
    #
    # enabled true
    # natural-scroll false
    # accel-speed 0.0
    # accel-profile "adaptive" # "adaptive" or "flat"
    # scroll-method "none"     # "none", "two-finger", "edge", or
    #                          # "on-button-down"
    # scroll-button 274        # Linux input button code
    # scroll-button-lock false
    # left-handed false
    # middle-emulation false
  end

  trackpoint:
    # Uses the same pointer fields as mouse. On-button scrolling is common:
    # scroll-method "on-button-down"
    # scroll-button 274
    # scroll-button-lock false
  end

  trackball:
    # Uses the same pointer fields as mouse.
    # accel-profile "flat"
    # middle-emulation true
  end

  touchscreen:
    # Raw contacts are exposed through wl_touch when a touchscreen is present.
    # map-to-output accepts an exact connector name. The calibration matrix is
    # libinput's row-major 2x3 affine transform.
    # enabled true
    # map-to-output "eDP-1"
    # calibration-matrix [1, 0, 0, 0, 1, 0]
  end

  # Optional exact-name overrides for individual devices. Names match
  # libinput's full device name, ignoring ASCII letter case; partial names do
  # not match. Values layer over the device's class block above.
  #
  # devices:
  #   "Logitech MX Master 3":
  #     accel-speed 0.6
  #     natural-scroll true
  #   end
  # end
end

# Cursor themes use the standard Xcursor search path and inheritance rules.
# Changes are applied immediately to Halley's cursor and exported to programs
# launched after the reload.
cursor:
  # `"default"` follows the desktop's configured Xcursor theme. Theme names
  # are case-sensitive; use `"Adwaita"` to require that theme explicitly.
  theme "default"

  # Base logical size. Halley selects the closest frame supplied by the theme
  # for each output scale.
  size 24

  # Hide after a physical keyboard press, without changing pointer focus,
  # grabs, or constraints. Pointer motion, buttons, and scrolling reveal it.
  hide-when-typing false

  # Hide after this many milliseconds without pointer activity. Set to 0 to
  # disable inactivity hiding.
  hide-after-ms 2000
end

# Window decoration settings. At present Halley draws one flat, fully opaque
# border around each managed window.
decorations:
  border:
    # Border width in output pixels. It follows camera zoom visually.
    size 3

    # Focused and unfocused colors accept "#rrggbb" or shorthand "#rgb".
    colour-focused "#38d1eb"
    colour-unfocused "#474d59"
  end
end

# Destination for PNG files created by the native screenshot menu and the
# desktop portal. `$env.HOME`, `$HOME`, and `~` home-directory spellings are
# supported. Missing directories are created when a screenshot is saved.
screenshot:
  directory "$env.HOME/Pictures/Screenshots/"
end

# Camera zoom changes both presentation and input coordinates. Halley only
# zooms outward: 1.0 is native size, and zooming in walks back toward 1.0
# without magnifying beyond it.
zoom:
  # Master switch for zoom input and any in-flight zoom motion.
  enabled true

  # Smallest permitted presentation scale. 0.35 means 35% of native size.
  # Runtime safety clamps this value to the range 0.05 through 1.0.
  min 0.35

  # Multiplicative change injected by each zoom action. Values must be above
  # 1.0 to produce a visible step.
  step 1.10

  # Response and settling rate. Higher values feel faster and more abrupt;
  # lower values feel softer. Runtime safety clamps it from 0.1 through 120.
  smooth-rate 12.5
end

# Global font for compositor-owned UI. The size is the base (scale 2) size;
# smaller text uses size - 2 and larger marker glyphs use size + 4.
font:
  family "monospace"
  size 11
end

# Focus rings are standalone and keyed by connector. They are intentionally
# separate from output mode/position configuration so each monitor can tune
# decay geometry without mixing presentation policy into hardware policy.
focus-ring:
  output "DP-1"
  radius-x 820.0
  radius-y 420.0
  offset-x 0.0
  offset-y 0.0
end

focus-ring:
  output "DP-2"
  radius-x 820.0
  radius-y 420.0
  offset-x 0.0
  offset-y 0.0
end

decay:
  enabled true
  outside-delay-seconds 180
  inside-delay-seconds 1800
end

# Active windows may overlap one another. Only collapsed node landmarks reserve
# readable space against other nodes and active windows.
field:
  gap-px 20.0
end

# Old-Halley contact motion for nodes and node/window displacement. Disable
# this for rigid movement: once contact begins, each unit pushed transfers
# directly to the contacted node or movable node chain.
physics:
  enabled true
  damping 0.45
end

placement:
  landmarks:
    strategy "nearest-free"
    normal-blocker "relocate"
  end
end

node:
  show-labels "hover"
  show-app-icons "always"
  shape "squircle"
  label-shape "squircle"
  icon-size 0.72
  opacity 1.0
  background-colour "auto"
  border-colour-hover "use-window-active"
  border-colour-inactive "use-window-inactive"

  # "never", "if-offscreen", or "always". Panning and restoration begin
  # together; there is no center-first, restore-second interaction.
  click-collapsed-pan "never"
end

debug:
  # The ring is still previewed briefly when its configuration changes.
  show-focus-ring false
end

# Animation settings are reloaded for future motion. Existing window-open and
# window-close animations keep the parameters with which they started.
animations:
  # Master switch for window-open, window-close, fullscreen, and node animations.
  enabled true

  window-open:
    # Independent switch for newly mapped windows.
    enabled true

    # Visual style:
    #   "center-out" - scale the window outward from its final center.
    #   "fade"       - keep the final geometry and fade from transparent to
    #                  opaque.
    #   "launch"     - travel along a short arc from the launcher, cursor,
    #                  focused window, or output center. The travel distance
    #                  is capped and the window settles after a tiny overshoot.
    type "center-out"

    # duration-ms is the complete time from the first frame through the
    # settled final frame. Curves redistribute progress inside that time:
    # "linear" advances evenly; "ease-out-quad", "ease-out-cubic", and
    # "ease-out-expo" cover increasingly more distance near the beginning;
    # "elastic" crosses the destination, then settles back. Launch applies
    # the curve once to travel while keeping its opacity and scale phases
    # anchored to the configured duration.
    duration-ms 300
    curve "linear"

    # Recommended launch motion:
    # type "launch"
    # duration-ms 220
    # curve "ease-out-cubic"
    #
    # Window-open motion also accepts `motion "spring"`. With spring motion,
    # use damping-ratio and stiffness as documented below instead of
    # duration-ms and curve.
  end

  window-close:
    # Independent switch for ordinary Wayland and XWayland toplevels.
    enabled true

    # "shrink" collapses the frozen final frame into its center without
    # fading. "fade" keeps its final geometry and changes only opacity.
    type "shrink"

    # Close animations use the original ease-in-out cubic timing internally.
    duration-ms 270
  end

  fullscreen:
    # Independent switch for fullscreen enter and exit transitions.
    enabled true

    # Motion model:
    #   "spring" - physically settles toward the target using the values
    #              below.
    #   "easing" - uses `duration-ms` and `curve` instead.
    motion "spring"

    # 1.0 is critically damped. Values below 1.0 permit bounce; values above
    # 1.0 remove overshoot but can settle more slowly.
    damping-ratio 1.0

    # Spring strength. Higher values reach the target more aggressively.
    stiffness 800.0

    # Example easing alternative:
    # motion "easing"
    # duration-ms 250
    # curve "ease-out-cubic"
  end

  node:
    enabled true
    duration-ms 280
  end
end

# A keybind entry is `"chord" "action"`. Modifiers are matched exactly:
# extra held modifiers prevent a chord from matching unless they are written
# into that chord. Trigger names are case-insensitive.
keybinds:
  # `$var.mod` in chord names expands to this modifier. Accepted values are
  # "super", "alt", "ctrl", and "shift".
  mod "super"

  # Built-in compositor actions.
  # `quit` exits immediately without a confirmation dialog.
  "$var.mod+shift+e" "quit"
  "$var.mod+c" "close-focused"
  "$var.mod+f" "toggle-fullscreen"
  "$var.mod+n" "toggle-state"

  # `open-terminal` uses `default-terminal` near the end of this section.
  "$var.mod+t" "open-terminal"

  # Any action string that is not a built-in action is executed as a command
  # line. These bindings control the default PipeWire sink through `wpctl`.
  "XF86AudioRaiseVolume" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0"
  "XF86AudioLowerVolume" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  "XF86AudioMute" "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"

  # Zoom out, walk back inward, or reset directly to native scale.
  "$var.mod+minus" "zoom-out"
  "$var.mod+equal" "zoom-in"
  "$var.mod+0" "zoom-reset"

  # Open the Region, Screen, and Window screenshot menu.
  "Print" "screenshot"

  # Keyboard, pointer-button, and physical-wheel triggers all use the same
  # chord syntax. Pointer and wheel bindings may also include `$var.mod`.
  # These are examples only; uncomment only the bindings you want.
  #
  # "$var.mod+Page_Up" "some-command"
  # "$var.mod+click-forward" "some-command"
  # "$var.mod+scroll-up" "zoom-in"
  # "$var.mod+scroll-down" "zoom-out"
  #
  # Unusual hardware can be addressed by its decimal Linux evdev code:
  # "keycode-99" "some-command"
  # "$var.mod+button-279" "some-command"
  #
  # See docs/keybinds.md for the complete trigger reference.

  # "auto" selects the first available terminal from Halley's detection
  # list. Replace it with an exact command such as "kitty" to skip detection.
  default-terminal "auto"
end
