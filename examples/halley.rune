# Halley compositor config.
# Everything else (gestures, ...) comes later, in its own section, once it
# actually exists.

# One `output:` block per physical monitor - not a wrapper section, just
# repeat the block for each one. Commented out by default: an active block
# whose `name` happens to match a real connector on your machine would force
# that exact mode, which is very likely wrong for hardware this file wasn't
# written for. Uncomment and edit to match your actual monitor(s) (find real
# connector names/modes with `halleyctl outputs`).
#
# output:
#   name "DP-1"
#   width 2560
#   height 1440
#   offset-x 0
#   offset-y 0
#
#   # Must match one of the connector's real modes exactly - no closest-rate
#   # guessing. Omit this line to use the highest refresh available at this
#   # resolution.
#   rate 179.998
#
#   # Rotation in degrees - 0, 90, 180, or 270.
#   transform 0
#
#   # "off", "on", or "auto" (variable refresh rate). "auto" is accepted but
#   # not yet content-aware - it behaves like "off" until there's a real
#   # signal to drive it.
#   vrr "auto"
# end

decorations:
  border:
    # Border width in pixels, drawn around every window.
    size 3

    # Color of the border around the focused window.
    colour-focused "#38d1eb"

    # Color of the border around every other (unfocused) window.
    colour-unfocused "#474d59"
  end
end

# A "zoom out" effect - visually shrinks everything toward the screen
# center, and back in again. Capped at 1.0x - zooming in only ever walks
# zoom-out steps back, it never magnifies past normal size.
zoom:
  enabled true

  # How far out you can zoom - 0.35 means windows can shrink to 35% size.
  min 0.35

  # Multiplicative zoom factor applied per zoom-out keypress.
  step 1.10

  # How quickly the zoom eases toward its target - higher is snappier.
  smooth-rate 12.5
end

# Animation settings. Only window opening exists for now; more animation
# names will be added only when their effects exist.
animations:
  # Master switch for all animations.
  enabled true

  window-open:
    # Enable or disable just the window-open animation.
    enabled true

    # newm's original center-out opening lasts 300 ms and moves linearly.
    duration-ms 300
    curve "linear"
  end
end

keybinds:
  mod "super"

  # Exit the compositor. No confirmation dialog - straight quit.
  "$var.mod+shift+e" "quit"

  # Close the focused window.
  "$var.mod+c" "close-focused"

  # Open a terminal. "auto" detects an installed terminal from a priority
  # list (alacritty, kitty, ghostty, wezterm, ...); set an explicit command
  # here instead to skip detection.
  "$var.mod+t" "open-terminal"

  # Zoom out one step, back in one step, or reset straight to 1.0x.
  "$var.mod+minus" "zoom-out"
  "$var.mod+equal" "zoom-in"
  "$var.mod+0" "zoom-reset"

  # Other keyboard, mouse, and physical-wheel triggers use the same chord
  # syntax. These are examples only; uncomment only the bindings you want.
  #
  # "Print" "grim ~/Pictures/screenshot.png"
  # "$var.mod+Page_Up" "some-command"
  # "$var.mod+click-forward" "some-command"
  # "$var.mod+scroll-up" "zoom-in"
  # "$var.mod+scroll-down" "zoom-out"
  #
  # Unusual hardware can be addressed by its decimal Linux evdev code:
  # "keycode-99" "some-command"
  # "$var.mod+button-279" "some-command"
  #
  # See docs/keybinds.md for the complete trigger reference.

  default-terminal "auto"
end
