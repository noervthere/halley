@author "Dustin Pilgrim"
@description "Halley split-config example"

# Gathered files are merged before Halley validates and applies the config.
# Paths are relative to the file containing each gather statement.
gather "theme.rune"
gather "field.rune"
gather "input.rune"

# Inline/raw sections are easiest to audit when kept in the root file.
autostart:
  # once "waybar"
  # once "mako"
  # on-reload "notify-send 'Halley configuration reloaded'"

  # Fresh configs start with six empty numbered workspaces on each of the two
  # sample outputs. Replace DP-1/DP-2 with names from `halleyctl outputs`, and
  # rename or remove these declarations to suit your setup. Empty members launch
  # no applications; output only controls initial placement.
  cluster:
    name "1"
    members []
    output "DP-1"
  end
  cluster:
    name "2"
    members []
    output "DP-1"
  end
  cluster:
    name "3"
    members []
    output "DP-1"
  end
  cluster:
    name "4"
    members []
    output "DP-1"
  end
  cluster:
    name "5"
    members []
    output "DP-1"
  end
  cluster:
    name "6"
    members []
    output "DP-1"
  end
  cluster:
    name "7"
    members []
    output "DP-2"
  end
  cluster:
    name "8"
    members []
    output "DP-2"
  end
  cluster:
    name "9"
    members []
    output "DP-2"
  end
  cluster:
    name "10"
    members []
    output "DP-2"
  end
  cluster:
    name "11"
    members []
    output "DP-2"
  end
  cluster:
    name "12"
    members []
    output "DP-2"
  end
end

keybinds:
  # Exact-side values such as "left-super" and "right-alt" are also valid.
  mod "super"

  "$var.mod+shift+e" "quit"
  "$var.mod+q" "close-focused"
  "$var.mod+f" "toggle-fullscreen"
  "$var.mod+m" "maximize-focused"
  "$var.mod+n" "toggle-state"
  "$var.mod+p" "toggle-focused-pin"
  "$var.mod+o" "apogee"
  "$var.mod+space" "center-last-focused"

  # Contextual navigation uses the Field, tiling, or stacking behavior that
  # matches the active workspace.
  "$var.mod+left" "focus-left"
  "$var.mod+right" "focus-right"
  "$var.mod+up" "focus-up"
  "$var.mod+down" "focus-down"

  "$var.mod+comma" "trail-prev"
  "$var.mod+period" "trail-next"

  "$var.mod+shift+left" "monitor-focus left"
  "$var.mod+shift+right" "monitor-focus right"
  "$var.mod+shift+up" "monitor-focus up"
  "$var.mod+shift+down" "monitor-focus down"
  # Exact connector names are accepted too: "monitor-focus DP-1".

  # The same chord can have different actions in non-overlapping contexts.
  "$var.mod+ctrl+left" "cluster-tile-swap-left" with scope "tile"
  "$var.mod+ctrl+right" "cluster-tile-swap-right" with scope "tile"
  "$var.mod+ctrl+up" "cluster-tile-swap-up" with scope "tile"
  "$var.mod+ctrl+down" "cluster-tile-swap-down" with scope "tile"
  "$var.mod+ctrl+left" "resize-window-left" with scope "field"
  "$var.mod+ctrl+right" "resize-window-right" with scope "field"
  "$var.mod+ctrl+up" "resize-window-up" with scope "field"
  "$var.mod+ctrl+down" "resize-window-down" with scope "field"

  "$var.mod+a" "arrange-visible"

  "$var.mod+shift+r" "reload"
  "$var.mod+t" "default-terminal"
  "$var.mod+d" "fuzzel"
  # "$var.mod+d" "halley-lift"
  "Print" "screenshot"

  # Compositor pointer grabs are ordinary remappable actions. Starting the
  # move action on empty Field pans it instead of moving a window. Drag-pan
  # keeps a grabbed window on its output and carries it through that Field
  # after dwelling against an edge.
  "$var.mod+click-left" "move-window"
  "$var.mod+click-right" "resize-window"
  "$var.mod+shift+click-left" "drag-pan"
  "click-left" "pan-field"

  "alt+tab" "cycle-focus"
  "alt+shift+tab" "cycle-focus-backward"
end

rules:
  window-rule:
    app-id "firefox"
    title [r"File Upload.*", r"Open File.*", r"Save File.*", r"Choose.*"]
    # width 720
    # height 520
    spawn-placement "center"
    cluster-participation "float"
  end

  # Per-window backdrop blur override (requires effects.blur.enabled).
  window-rule:
    app-id "Alacritty"
    opacity 0.86
    blur true
  end
end

debug:
  overlay-fps false
  show-focus-ring false
end
